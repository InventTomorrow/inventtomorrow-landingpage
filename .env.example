# Copy to .env.local for development. Import private .env.production.local
# into Vercel's Production environment before deployment.
# Credentials stay server-only; never add a VITE_ prefix.

# Required for AI chat and the cleaning-business audit report.
KOBOILLM_API_KEY=
KOBOILLM_BASE_URL=https://api.koboillm.com/v1
KOBOILLM_MODEL=gpt-6-luna
# Optional model override for audit reports only.
KOBOILLM_AUDIT_MODEL=

# Direct Gmail delivery. Authorize once with npm run connect:gmail.
# See docs/gmail-setup.md. Sending is disabled in this example.
GMAIL_AUDIT_REPORTS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Team notifications for contact, case-study unlock and chat booking requests.
# If omitted, this flag follows GMAIL_AUDIT_REPORTS_ENABLED.
GMAIL_FORM_NOTIFICATIONS_ENABLED=false
# Optional team inbox; defaults to GMAIL_SENDER_EMAIL. Server-only.
GMAIL_NOTIFICATION_EMAIL=

# Test builds only (ignored in production builds): fixed countdown preview.
# VITE_COUNTDOWN_TEST_DAYS=13
