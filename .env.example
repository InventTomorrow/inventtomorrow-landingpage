# Copy to .env.local for local development.
# On Vercel, add these values under Project Settings > Environment Variables.
# These variables are server-only. Never add a VITE_ prefix to keys or webhook URLs.

# Required for the audit chatbot at /api/chat.
KOBOILLM_API_KEY=

# Optional provider overrides; these match the server's defaults.
KOBOILLM_BASE_URL=https://api.koboillm.com/v1
KOBOILLM_MODEL=gpt-4.1-mini

# Shared chat + audit form webhook. Required for submitting audit requests.
# Chat sends source=invo_chat; the form sends source=form_data to this same URL.
N8N_WEBHOOK_URL=
N8N_LOG_EVERY_MESSAGE=true

# Optional durable chat delivery, with no MongoDB/Redis database required.
# Set QSTASH_TOKEN on Vercel to enqueue logs before the AI runs; QStash then
# retries n8n independently of the visitor's browser. Without it, delivery is
# direct/best-effort and pending logs retry only while the site is open/reopened.
# Use the QStash URL shown in your account if it differs from the default.
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io

# Local development and previews use the test webhook by default.
# The test endpoint only works while n8n is listening for a test event.
N8N_WEBHOOK_TEST_URL=

# Set true to use the production webhook outside Vercel Production deployments.
# Vercel Production automatically uses N8N_WEBHOOK_URL via VERCEL_ENV=production.
N8N_USE_PRODUCTION=false
