    {
      "parameters": {
        "jsCode": "// One sheet row per chat visit. Every message carries everything known so far, so each update\n// can safely overwrite the row. Details show up as soon as the visitor types them.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const p = item.json.body ?? item.json;\n  const transcript = Array.isArray(p.transcript) ? p.transcript : [];\n  const lead = p.lead || {};\n\n  const contact = [\n    lead.name && `Name: ${lead.name}`,\n    lead.businessName && `Business: ${lead.businessName}`,\n    lead.email && `Email: ${lead.email}`,\n    lead.phone && `Phone: ${lead.phone}`,\n  ].filter(Boolean);\n\n  out.push({\n    json: {\n      'Session ID': p.sessionId || `no-session-${Date.now()}`,\n      'Last Updated': p.timestamp || new Date().toISOString(),\n      'Contact Detials': contact.join('\\n'),\n      'Main Concern': lead.description || '',\n      'Lead Captured': p.leadCaptured === true ? 'Yes' : 'No',\n      'Asked To Book Directly': p.askedToBookDirectly === true ? 'Yes' : 'No',\n      'Chat': transcript\n        .map((m) => `${m.role === 'user' ? 'Visitor' : 'Invo'}: ${m.content}`)\n        .join('\\n'),\n    },\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
