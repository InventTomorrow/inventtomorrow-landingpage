    {
      "parameters": {
        "jsCode": "const incoming = $('Structure Output').first().json;\nconst existing = $input.first().json;\n// FIFO queue + acknowledgement after writing serializes the read/write pair.\n// Equal/older versions are safe no-ops, including retries after dedupe expires.\nif (existing['Conversation ID'] === incoming['Conversation ID'] &&\n    Number(existing['Version'] || 0) >= Number(incoming['Version'])) {\n  return [];\n}\n// Partial updates must not erase details collected earlier in the session.\nfor (const key of ['Contact Detials', 'Main Concern']) {\n  if (!incoming[key] && existing[key]) incoming[key] = existing[key];\n}\nif (existing['Lead Captured'] === 'Yes') incoming['Lead Captured'] = 'Yes';\nif (existing['Asked To Book Directly'] === 'Yes') incoming['Asked To Book Directly'] = 'Yes';\nreturn [{ json: incoming }];"
      },
