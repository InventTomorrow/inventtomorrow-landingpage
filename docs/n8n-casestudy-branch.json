      "parameters": {
        "jsCode": "// INVENT TOMORROW — case study unlock lead (source: form-casestudy).\n// Website payload: { source, event:'case_study_unlock', submissionId, sessionId, timestamp,\n//   pagePath, caseStudySlug, utm_*, lead:{name,businessName,email,phone,description}, leadCaptured }\nconst SETTINGS = {\n  teamAlertEmail: 'malik.rehan.shoukat@gmail.com', // REPLACE with the inbox that should get case study leads\n};\nconst src = $input.first().json;\nconst p = src.body || src;\nconst lead = p.lead || {};\nconst str = (v) => String(v ?? '').trim();\nconst esc = (v) => str(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');\n\n// The site retries with the same submissionId, so this is also the sheet's de-duplication key.\nconst submissionId = str(p.submissionId);\nif (!submissionId) throw new Error('Missing submissionId: cannot safely save or acknowledge this lead');\nconst email = str(lead.email).toLowerCase();\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Valid lead email missing');\n\nconst slug = str(p.caseStudySlug);\nconst title = slug.replace(/-/g, ' ').replace(/\\b\\w/g, (c) => c.toUpperCase());\nconst name = str(lead.name);\nconst business = str(lead.businessName);\nconst phone = str(lead.phone);\nconst tracking = p.tracking || {};\nconst utm = (k) => str(p[k] ?? tracking[k]);\nconst clickId = [['gclid', utm('gclid')], ['fbclid', utm('fbclid')], ['msclkid', utm('msclkid')]]\n  .filter(([, v]) => v).map(([k, v]) => k + '=' + v).join(' ');\n\nconst submittedAt = str(p.timestamp) || new Date().toISOString();\nconst pagePath = str(p.pagePath) || (slug ? '/our-work/' + slug : '');\n\nreturn [{ json: {\n  submission_id: submissionId,\n  'Submission ID': submissionId,\n  'Submitted At': submittedAt,\n  Name: name,\n  'Business Name': business,\n  Email: email,\n  Phone: phone,\n  'Case Study': slug,\n  'Page Path': pagePath,\n  Source: 'form-casestudy',\n  'Session ID': str(p.sessionId),\n  'UTM Source': utm('utm_source'),\n  'UTM Medium': utm('utm_medium'),\n  'UTM Campaign': utm('utm_campaign'),\n  'Click ID': clickId,\n  alert_to: SETTINGS.teamAlertEmail,\n  alert_subject: ('New case study lead: ' + (business || name || email)).slice(0, 120),\n  alert_html: '<p><strong>Someone unlocked a case study.</strong></p>'\n    + '<p>Case study: ' + esc(title || slug) + ' (' + esc(pagePath) + ')<br>'\n    + 'Name: ' + esc(name) + '<br>'\n    + 'Business: ' + esc(business) + '<br>'\n    + 'Email: ' + esc(email) + '<br>'\n    + 'Phone: ' + esc(phone) + '<br>'\n    + 'Source: form-casestudy<br>'\n    + 'Submitted: ' + esc(submittedAt) + '</p>',\n  alert_text: 'New case study lead\\nCase study: ' + (title || slug)\n    + '\\nName: ' + name + '\\nBusiness: ' + business + '\\nEmail: ' + email + '\\nPhone: ' + phone,\n}}];\n"
      },
